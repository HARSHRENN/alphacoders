{
  "name": "pulse-team",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.2.0",
    "gsap": "^3.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:android": "expo export --platform android --output-dir dist/android",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev": "expo start --web --port 8081",
    "format": "prettier --write App.tsx app.config.ts src tests",
    "format:check": "prettier --check App.tsx app.config.ts src tests",
    "lint": "expo lint",
    "build:hosted": "node scripts/write-cloud-config.mjs --validate-only && npm run build:web && node scripts/write-cloud-config.mjs",
    "apk:local": "node scripts/build-apk.mjs"
  },
  "private": true
}
