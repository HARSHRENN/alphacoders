# Supabase public project credentials; never put service-role keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public Firebase SDK config; never add a server service-account key here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set after `eas init`; required for live push token registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local path or an EAS file environment variable for Firebase Android config.
GOOGLE_SERVICES_JSON=
